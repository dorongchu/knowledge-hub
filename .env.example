# Supabase 대시보드 → Project Settings → API 에서 복사
# 이 두 값은 클라이언트에 노출되는 공개 값. 비밀 키(service_role, ANTHROPIC_API_KEY)는 절대 여기에 넣지 않는다.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# AI 태그 제안 버튼 표시 여부 (기본 false). Anthropic API 는 종량제 과금이므로 쓸 때만 켠다.
# 켜기 전에 서버에 키를 등록해야 한다: npx supabase secrets set ANTHROPIC_API_KEY=...
VITE_ENABLE_AI_TAGGING=false
